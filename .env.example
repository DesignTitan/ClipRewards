# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Leave these unset to run ClipRewards in DEMO MODE (in-memory seeded data).
# Set them to point the whole app at a real Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by API routes that write on behalf of the platform
# (clip generation callbacks, payout state transitions). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI clipping provider (optional — see src/lib/ai/clipper.ts)
# ---------------------------------------------------------------------------
# Which provider implementation to use: "stub" | "http"
CLIPPER_PROVIDER=stub
# For CLIPPER_PROVIDER=http — your video-splitting service endpoint.
CLIPPER_API_URL=
CLIPPER_API_KEY=
# Shared secret the provider signs its webhook callbacks with.
CLIPPER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Site password gate (src/proxy.ts)
# ---------------------------------------------------------------------------
# Shared password in front of the whole app while it is a private preview.
# Defaults to "bubs2026" when unset.
SITE_PASSWORD=
